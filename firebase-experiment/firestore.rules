rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() {
      return request.auth != null && request.auth.uid == '76XXWSwa4FgMRHAp01Aa13qrfLn1'
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function editor() {
      return owner() || (request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && exists(/databases/$(database)/documents/organizerAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizerAccess/$(request.auth.uid)).data.enabled == true);
    }
    match /organizerDrafts/{uid}/items/{draftId} {
      allow read, delete: if editor() && request.auth.uid == uid;
      allow create, update: if editor() && request.auth.uid == uid
        && request.resource.data.uid == uid && request.resource.data.draft is map
        && request.resource.data.version is string;
    }
    match /organizerDraftIndexes/{uid} {
      allow read: if editor() && request.auth.uid == uid;
      allow create, update: if editor() && request.auth.uid == uid
        && request.resource.data.uid == uid && request.resource.data.items is map;
    }
    function openTournament(slug) {
      let path = /databases/$(database)/documents/public/tournamentStatus;
      return exists(path) ? get(path).data.events.get(slug, slug == 'v3fgwg53') == false : slug != 'v3fgwg53';
    }
    match /public/tournamentStatus {
      allow get: if true;
      allow create, update: if editor() && request.resource.data.keys().hasOnly(['events']) && request.resource.data.events is map;
    }
    match /public/dashboard {
      allow get: if true;
      allow update: if editor() && request.resource.data.schema == 1
        && request.resource.data.players is list && request.resource.data.matches is list
        && request.resource.data.tournaments is list && request.resource.data.revision is string;
      allow list, create, delete: if false;
    }
    match /organizerOverrides/{slug} {
      allow read: if editor();
      allow delete: if owner() && openTournament(slug);
      allow create, update: if editor() && openTournament(slug) && request.resource.data.source.event.slug == slug
        && request.resource.data.updatedBy == request.auth.uid;
    }
    match /organizerUndo/{revision} {
      allow read: if owner();
      allow create: if editor() && request.resource.data.revision == revision
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /organizerBackups/{revision} {
      allow read: if owner();
      allow create: if editor();
      allow update, delete: if false;
    }
    match /organizerAudit/{revision} {
      allow read: if editor();
      allow create: if editor() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /organizerAccess/{uid} {
      allow read, write: if owner();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
